# ═══════════════════════════════════════════════════════════════
#  MATCHY PLATFORM — Docker Environment Variables
#  Copy to .env before running docker compose
# ═══════════════════════════════════════════════════════════════

# ── Database ──
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=matchy_db

# ── JWT ──
JWT_SECRET=dev-shared-secret-change-me-please-please-please-32bytes

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=matchy123

# ── SonarQube ──
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar

# ── Docker Hub (for Jenkins push) ──
DOCKER_HUB_USERNAME=matchyplatform
DOCKER_HUB_PASSWORD=your_password_here

# ── ML Service ──
ML_PORT=8085
